{
  "name": "advatek-pixlite-contact-closure-trigger",
  "version": "1.0.0-beta.6",
  "private": true,
  "type": "module",
  "description": "Sustainable ESP32 contact-closure controller for PixLite Mk3.",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts && node tools/embed-web.mjs",
    "build:sketch": "node tools/build-sketch.mjs",
    "build": "pnpm build:web && pnpm build:sketch",
    "test": "vitest run",
    "test:native": "node tools/test-native.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:docs": "node tools/check-docs.mjs",
    "build:docs-site": "node tools/build-docs-site.mjs",
    "check:docs-site": "node tools/build-docs-site.mjs --check",
    "check:generated": "node tools/build-sketch.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "marked": "^18.0.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "packageManager": "pnpm@10.12.1"
}
