{
  "name": "advatek-pixlite-contact-closure-trigger",
  "version": "1.0.0-beta.6",
  "private": true,
  "type": "module",
  "description": "Sustainable ESP32 contact-closure controller for PixLite Mk3.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts && node tools/embed-web.mjs",
    "build:sketch": "node tools/build-sketch.mjs",
    "build": "pnpm build:web && pnpm build:sketch",
    "test": "vitest run",
    "test:native": "node tools/test-native.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:docs": "node tools/check-docs.mjs",
    "dev:docs-preview": "pnpm build:docs-preview && vite preview --config docs-preview/vite.config.mjs --host 127.0.0.1 --port 4321 --outDir .build/docs-preview/dist",
    "build:docs-preview": "node tools/stage-docs-preview.mjs && astro build --root .build/docs-preview",
    "build:docs-site": "node tools/build-docs-site.mjs",
    "check:docs-site": "node tools/build-docs-site.mjs --check",
    "check:generated": "node tools/build-sketch.mjs --check"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@types/node": "^24.0.0",
    "astro": "^7.1.4",
    "cookie": "^2.0.1",
    "marked": "^18.0.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "packageManager": "pnpm@10.12.1"
}
